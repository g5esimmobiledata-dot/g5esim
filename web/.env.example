# Database
DATABASE_URL=postgresql://localhost:5432/g5esim
PORT=5000
NODE_ENV=development
BASE_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:5000
# Set true on preview/PWA hosting when the test copy should not run provider sync,
# invoice, IPTV, or usage background jobs.
DISABLE_BACKGROUND_JOBS=true

# Stripe Payments

STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLIC_KEY=


# eSIM Providers
AIRALO_API_KEY=
AIRALO_API_SECRET=
ESIM_ACCESS_CLIENT_ID=
ESIM_ACCESS_CLIENT_SECRET=
ESIM_GO_API_KEY=
MAYA_API_KEY=
MAYA_API_SECRET=
AIRHUB_USERNAME=
AIRHUB_PASSWORD=
AIRHUB_PARTNER_CODE=
# Optional: use this instead of username/password login if Airhub gives you a static token
AIRHUB_API_TOKEN=

# Telna provider moved to the dedicated Telna project.
# Telna-specific environment variables are now managed in the Telna project.

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Outbound SMS carrier
# Inbound SMS for Vonage eRoaming numbers is still handled by the Vonage webhook routes.
SMS_CARRIER_ENABLED=
SMS_CARRIER_PROVIDER=
SMS_CARRIER_API_URL=
SMS_CARRIER_USERNAME=
SMS_CARRIER_PASSWORD=
SMS_CARRIER_SENDER_ID=

# OneSignal (optional, can also be configured from Admin > Settings > OneSignal)
ONESIGNAL_ENABLED=
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
ONESIGNAL_SAFARI_WEB_ID=
ONESIGNAL_PROMPT_ENABLED=
ONESIGNAL_EMAIL_ENABLED=
ONESIGNAL_EMAIL_FROM_NAME=
ONESIGNAL_EMAIL_FROM_ADDRESS=
ONESIGNAL_EMAIL_REPLY_TO=

# Telegram Mini App
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MINI_APP_URL=

# WhatsApp Cloud API
# Can also be configured from Admin > Settings > WhatsApp.
WHATSAPP_CLOUD_ENABLED=
WHATSAPP_CLOUD_MODE=
WHATSAPP_CLOUD_PHONE_NUMBER=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_VERIFY_TOKEN=
WHATSAPP_CLOUD_API_VERSION=
WHATSAPP_PWA_URL=

# Session
SESSION_SECRET=


JWT_SECRET=



GOOGLE_SERVICE_ACCOUNT_PATH=./server/config/service-account.json
ANDROID_PACKAGE_NAME=

IOS_KEY_ID=
IOS_ISSUER_ID=
IOS_APP_ID=
IOS_BUNDLE_ID=

# Apple private key for App Store Connect API (ES256)
# Newlines encoded as \n so it works as a single env line
IOS_PRIVATE_KEY=
IOS_SHARED_SECRET=



APPLE_PROD_URL=
APPLE_SANDBOX_URL=


POWERTRANZ_MERCHANT_ID=
POWERTRANZ_MERCHANT_PASSWORD=
POWERTRANZ_PAGE_SET=
POWERTRANZ_PAGE_NAME=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# OpenAI
OPENAI_API_KEY=
# Optional: Admin API key can read official organization costs.
OPENAI_ADMIN_API_KEY=
# Optional: set one of these when you want the dashboard to show a remaining balance.
OPENAI_BALANCE_USD=
OPENAI_MONTHLY_BUDGET_USD=
