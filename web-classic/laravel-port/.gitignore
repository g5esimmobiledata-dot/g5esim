/vendor
/.env
/.env.*
!.env.example
/bootstrap/cache/*.php
/storage/*.key
/storage/app/private/*
!/storage/app/private/.gitkeep
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitkeep
